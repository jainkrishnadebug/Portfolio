---
interface Props {
  title: string;
  summary: string;
  href: string;
  year?: number;
  tags?: string[];
  meta?: string;
  image?: string;
}
const { title, summary, href, year, tags = [], meta, image } = Astro.props;
---
<article class="content-card">
  {image && <img class="content-card-image" src={image} alt="" loading="lazy" />}
  <div class="content-card-topline">
    <span>{meta || 'entry'}</span>
    {year && <span>{year}</span>}
  </div>
  <h2><a href={href}>{title}</a></h2>
  <p>{summary}</p>
  {tags.length > 0 && <div class="tag-list">{tags.map((tag) => <span>{tag}</span>)}</div>}
  <a class="card-link" href={href}>read more <span aria-hidden="true">↗</span></a>
</article>
