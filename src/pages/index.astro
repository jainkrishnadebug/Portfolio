---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const portraits = [
  { src: `${import.meta.env.BASE_URL}assets/ceremonial-cadet-parade.webp`, alt: 'Ceremonial cadet on a sunny parade ground', className: 'photo-card-third' },
  { src: `${import.meta.env.BASE_URL}assets/krishna-formal-portrait.webp`, alt: 'Krishna Jain wearing a formal suit', className: 'photo-card-formal' },
  { src: `${import.meta.env.BASE_URL}assets/krishna-outdoor-portrait.webp`, alt: 'Krishna Jain outdoors', className: 'photo-card-current' }
];
---
<BaseLayout title="About — Krishna Jain">
  <div class="about-layout">
    <section class="intro-copy" aria-labelledby="page-title">
      <h1 class="hero-greeting" id="page-title" role="button" tabindex="0" aria-label="Say hello in Gujarati">
        Hi!<span lang="gu">केम छो? मजा मा!</span>
      </h1>
      <div class="copy-body">
        <div class="intro-heading-row">
          <h2 class="signature-heading" id="profile-intro-trigger" data-font-mix role="button" tabindex="0" aria-label="Switch portrait">I'm Krishna Jain<span class="signature-dot">.</span></h2>
          <div class="mail-contact">
            <span class="mail-address">jainkrishna.research@gmail.com</span>
            <button class="copy-email" type="button" data-copy-email="jainkrishna.research@gmail.com" aria-label="Copy email" title="Copy email">
              <svg class="copy-symbol" aria-hidden="true" viewBox="0 0 24 24"><rect x="8" y="8" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
            </button>
          </div>
        </div>
        <p data-font-mix>3rd-year B.Tech student majoring in Mechanical Engineering with a minor in Computer Science at IIT Delhi.</p>
        <div class="profile-status" data-font-mix>
          <strong>Currently:</strong>
          <ul>
            <li><span class="status-category">Competitions -</span>
              <ul>
                <li><a href="https://www.kaggle.com/competitions/nfl-big-data-bowl-2027" target="_blank" rel="noreferrer">NFL Big Data Bowl 2027</a></li>
                <li><a href="https://atcoder.jp/contests/ahc073/tasks/ahc073_a" target="_blank" rel="noreferrer">AHC073 Circles of Inversion</a></li>
              </ul>
            </li>
            <li><a href="https://github.com/gambitproject/gambit/issues/1181" target="_blank" rel="noreferrer">Working in gambit project</a></li>
          </ul>
        </div>
        <div class="profile-status" data-font-mix>
          <strong>Upcoming:</strong>
          <ul><li><a href="https://www.tatasteel.com/#investors" target="_blank" rel="noreferrer">Tata Steel Inspire Internship Program 2027</a>.</li></ul>
        </div>
      </div>
    </section>

    <aside class="profile-panel" aria-label="Profile and social links">
      <SocialLinks />
      <div class="photo-frame" id="profile-photo" role="button" tabindex="0" aria-label="Switch portrait">
        {portraits.map((portrait) => <div class:list={['photo-placeholder', 'photo-card', portrait.className]}><img class="profile-portrait" src={portrait.src} alt={portrait.alt} decoding="async" /></div>)}
        <span class="frame-number">[ 001 ]</span>
      </div>
    </aside>
  </div>
</BaseLayout>
