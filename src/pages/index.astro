---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const portraits = [
  { src: `${import.meta.env.BASE_URL}assets/ceremonial-cadet-parade.webp`, alt: 'Ceremonial cadet on a sunny parade ground', className: 'photo-card-third' },
  { src: `${import.meta.env.BASE_URL}assets/krishna-formal-portrait.webp`, alt: 'Krishna Jain wearing a formal suit', className: 'photo-card-formal' },
  { src: `${import.meta.env.BASE_URL}assets/krishna-outdoor-portrait.webp`, alt: 'Krishna Jain outdoors', className: 'photo-card-current' }
];
---
<BaseLayout title="About — Krishna Jain">
  <div class="about-layout">
    <section class="intro-copy" aria-labelledby="page-title">
      <h1 class="hero-greeting" id="page-title" role="button" tabindex="0" aria-label="Say hello in Gujarati">
        Hi!<span lang="gu">केम छो? मजा मा!</span>
      </h1>
      <div class="copy-body">
        <h2 id="profile-intro-trigger" data-font-mix role="button" tabindex="0" aria-label="Switch portrait">Krishna Jain this side.</h2>
        <p data-font-mix>Welcome! I enjoy using mathematics, computation, and systems thinking to understand complex problems and build useful solutions.</p>
        <p data-font-mix><strong>Currently:</strong> 3rd-year B.Tech student majoring in Mechanical Engineering with a minor in Computer Science at IIT Delhi.</p>
        <p data-font-mix><strong>Upcoming:</strong> Tata Steel Inspire Internship Program.</p>
      </div>
    </section>

    <aside class="profile-panel" aria-label="Profile and social links">
      <SocialLinks />
      <div class="photo-frame" id="profile-photo" role="button" tabindex="0" aria-label="Switch portrait">
        {portraits.map((portrait) => <div class:list={['photo-placeholder', 'photo-card', portrait.className]}><img class="profile-portrait" src={portrait.src} alt={portrait.alt} decoding="async" /></div>)}
        <span class="frame-number">[ 001 ]</span>
      </div>
    </aside>
  </div>
</BaseLayout>
